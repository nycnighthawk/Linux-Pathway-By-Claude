#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > 10-forward.conf <<'EOT'
# SPDX-License-Identifier: MIT
action(type="omfwd" target="logs.example.org" port="6514" protocol="tcp"
       StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name"
       StreamDriverPermittedPeers="logs.example.org"
       queue.type="LinkedList" queue.filename="fwd" queue.saveOnShutdown="on"
       queue.maxDiskSpace="1g" action.resumeRetryCount="-1")
EOT
cat > logrotate-myapp.conf <<'EOT'
# SPDX-License-Identifier: MIT
/var/log/myapp/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    postrotate
        systemctl kill -s HUP myapp.service || true
    endscript
}
EOT
cat > answers.txt <<'EOT'
# SPDX-License-Identifier: MIT
lossy_transport=UDP
previous_boot_kernel_log=journalctl -b -1 -k
rotation_without_reload_symptom=the new file stays empty and the service writes to the old file
EOT
