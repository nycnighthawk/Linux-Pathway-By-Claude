#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: a recorded host snapshot, a service summary, an answer sheet and a runbook template.
set -eu
cd "${LAB_DIR:-.}"
rm -f snapshot.txt service.txt answers.txt runbook.md
cat > snapshot.txt <<'EOT'
# resource      util_pct  saturation_metric        saturation_value  errors
cpu                   62  runqueue_per_core                    0.4       0
memory                71  swap_out_kb_per_s                      0       0
disk_sda              97  queue_size                            14       0
disk_sdb              12  queue_size                             0       0
net_eth0               8  drops_per_s                            0       0
fd_table              35  blocked_tasks                          0       0
EOT
cat > service.txt <<'EOT'
service=checkout rate_per_s=1200 error_ratio_pct=0.5 p99_ms=1900 p50_ms=40
EOT
printf '# SPDX-License-Identifier: MIT\n# Fill in each ? from snapshot.txt and service.txt (see README.md)\nbottleneck=?\ncheck_order=?\nservice_symptom=?\nfirst_method=?\n' > answers.txt
printf '# SPDX-License-Identifier: MIT\n# Runbook: DiskQueueDeep\n\nTODO: write the sections listed in README.md\n' > runbook.md
