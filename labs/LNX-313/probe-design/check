# SPDX-License-Identifier: MIT
set -u
cd "${LAB_DIR:-.}"
python3 - <<'PY'
import sys, yaml
bad = 0
def chk(c, m):
    global bad
    print(("ok:   " if c else "FAIL: ") + m)
    if not c: bad = 1
try:
    p = yaml.safe_load(open("pod.yaml")); s = p["spec"]
    c = s["containers"][0]
    sp, rp, lp = (c.get(k) or {} for k in ("startupProbe", "readinessProbe", "livenessProbe"))
    path = lambda x: (x.get("httpGet") or {}).get("path")
    chk(path(sp) == "/healthz" and sp.get("httpGet", {}).get("port") == 8080, "startup probe on /healthz:8080")
    budget = sp.get("periodSeconds", 10) * sp.get("failureThreshold", 3)
    chk(sp.get("periodSeconds") == 5 and 120 <= budget <= 180, f"startup budget {budget}s is within 120 to 180")
    chk(path(rp) == "/ready" and rp.get("periodSeconds") == 5 and rp.get("failureThreshold") == 2 and rp.get("timeoutSeconds") == 2, "readiness probe /ready 5s/2/2s")
    chk(path(lp) == "/live" and lp.get("periodSeconds") == 10 and lp.get("failureThreshold") == 3 and lp.get("timeoutSeconds") == 2, "liveness probe /live 10s/3/2s")
    chk(path(lp) != path(rp), "liveness and readiness use different paths")
    chk("initialDelaySeconds" not in lp, "no large initial delay on liveness (the startup probe covers the start)")
    ps = ((c.get("lifecycle") or {}).get("preStop") or {}).get("exec", {}).get("command") or []
    chk(ps[-1:] == ["sleep 5"] or ps[-2:] == ["sleep", "5"], "preStop sleep 5")
    chk(s.get("terminationGracePeriodSeconds") == 30, "terminationGracePeriodSeconds 30")
    a = dict(l.split("=", 1) for l in open("answer.txt").read().split() if "=" in l)
    chk(a.get("max_start_s") == str(budget), f"max_start_s equals the startup budget ({budget})")
    chk(a.get("liveness_detect_s") == "30", "liveness_detect_s is 30")
except Exception as e:
    print("FAIL:", repr(e)); bad = 1
sys.exit(bad)
PY
