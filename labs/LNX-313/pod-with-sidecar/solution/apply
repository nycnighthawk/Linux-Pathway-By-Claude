#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > pod.yaml <<'J'
# SPDX-License-Identifier: MIT
apiVersion: v1
kind: Pod
metadata:
  name: shop
spec:
  initContainers:
    - name: wait-db
      image: busybox:1.37
      command: ["sh", "-c", "until nc -z db 5432; do sleep 2; done"]
      resources: {requests: {cpu: 50m}}
    - name: log-agent
      image: fluent/fluent-bit:3.2
      restartPolicy: Always
      startupProbe:
        httpGet: {path: /, port: 2020}
      volumeMounts:
        - {name: logs, mountPath: /logs, readOnly: true}
      resources: {requests: {cpu: 100m}}
    - name: migrate
      image: registry.example/shop:1.0
      command: ["shop", "migrate"]
      resources: {requests: {cpu: 1000m}}
  containers:
    - name: app
      image: registry.example/shop:1.0
      volumeMounts:
        - {name: logs, mountPath: /logs}
      resources: {requests: {cpu: 500m}}
  volumes:
    - name: logs
      emptyDir: {}
J
echo "effective_cpu_m=1100" > answer.txt
