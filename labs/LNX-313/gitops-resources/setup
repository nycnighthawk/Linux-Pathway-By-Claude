#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > argocd.yaml <<'J'
# SPDX-License-Identifier: MIT
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata: {name: shop-api, namespace: argocd}
spec:
  project: default
  source: {repoURL: "https://git.example/shop/config.git", path: apps/api, targetRevision: HEAD}
  destination: {server: "https://kubernetes.default.svc", namespace: default}
J
printf '%s\n' '# SPDX-License-Identifier: MIT' > flux.yaml
