#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
cd "${LAB_DIR:-.}"
python3 - <<'PY'
import sys, yaml
bad = 0
def chk(c, m):
    global bad
    print(("ok:   " if c else "FAIL: ") + m)
    if not c: bad = 1
try:
    d = yaml.safe_load(open("rolling.yaml")); s = d["spec"]
    ru = (s.get("strategy") or {}).get("rollingUpdate") or {}
    chk(d["kind"] == "Deployment" and s.get("replicas") == 12, "Deployment web with 12 replicas")
    chk((s.get("strategy") or {}).get("type") == "RollingUpdate" and ru.get("maxSurge") == 3 and ru.get("maxUnavailable") == 0, "surge 3, unavailable 0")
    chk(s.get("minReadySeconds") == 15 and s.get("progressDeadlineSeconds") == 300 and s.get("revisionHistoryLimit") == 5, "timers and history")
    chk("readinessProbe" in s["template"]["spec"]["containers"][0], "readiness probe present")
    docs = [x for x in yaml.safe_load_all(open("bluegreen.yaml")) if x]
    svc = [x for x in docs if x["kind"] == "Service" and x["metadata"]["name"] == "web"]
    chk(bool(svc) and svc[0]["spec"]["selector"] == {"app": "web", "track": "green"}, "Service selects app web, track green")
    for c in ("blue", "green"):
        dep = [x for x in docs if x["kind"] == "Deployment" and x["metadata"]["name"] == f"web-{c}"]
        ok = bool(dep) and dep[0]["spec"]["replicas"] == 3 and dep[0]["spec"]["template"]["metadata"]["labels"].get("track") == c \
             and dep[0]["spec"]["selector"]["matchLabels"].get("track") == c and dep[0]["spec"]["template"]["metadata"]["labels"].get("app") == "web"
        chk(ok, f"Deployment web-{c} labelled track {c} with 3 replicas")
    a = dict(l.split("=", 1) for l in open("answer.txt").read().split() if "=" in l)
    chk(a.get("canary_share_pct") == "10", "canary share is 10 percent")
    chk(a.get("min_total_for_5pct") == "20", "20 Pods give a 5 percent canary")
except Exception as e:
    print("FAIL:", repr(e)); bad = 1
sys.exit(bad)
PY
