#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > rolling.yaml <<'J'
# SPDX-License-Identifier: MIT
apiVersion: apps/v1
kind: Deployment
metadata: {name: web}
spec:
  replicas: 12
  selector: {matchLabels: {app: web}}
  template:
    metadata: {labels: {app: web}}
    spec:
      containers:
        - {name: web, image: registry.example/web:1}
J
cat > bluegreen.yaml <<'J'
# SPDX-License-Identifier: MIT
apiVersion: v1
kind: Service
metadata: {name: web}
spec:
  selector: {app: web}
  ports: [{port: 80}]
J
printf 'canary_share_pct=0\nmin_total_for_5pct=0\n' > answer.txt
