  - {name: ipa1,   ip: 10.20.0.11, family: rhel,   release: "9",  roles: [idm-server]}
  - {name: dc1,    ip: 10.20.0.12, family: samba,  release: "4",  roles: [samba-dc]}
  - {name: repo1,  ip: 10.20.0.13, family: rhel,   release: "9",  roles: [repo, idm-client]}
  - {name: mon1,   ip: 10.20.0.14, family: rhel,   release: "9",  roles: [monitoring, idm-client]}
  - {name: app1,   ip: 10.20.0.15, family: rhel,   release: "9",  roles: [idm-client, node-exporter]}
  - {name: app2,   ip: 10.20.0.15, family: rhel,   release: "9",  roles: [idm-client, node-exporter]}
  - {name: app3,   ip: 10.20.0.17, family: rhel,   release: "9",  roles: [idm-client, node-exporter]}
