#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: a three-rule XCCDF benchmark with OVAL checks, and a host directory that fails every rule.
set -eu
cd "${LAB_DIR:-.}"
rm -rf host xccdf.xml oval.xml results-*.xml report-*.html answers.txt
mkdir -p host/etc
printf 'PermitRootLogin yes\n' > host/etc/sshd_config
printf 'deny = 10\n' > host/etc/faillock.conf
printf 'PASS_MAX_DAYS 99999\n' > host/etc/login.defs
cat > oval.xml <<X
<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<oval_definitions xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5" xmlns:oval="http://oval.mitre.org/XMLSchema/oval-common-5" xmlns:ind="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <generator><oval:product_name>lab</oval:product_name><oval:schema_version>5.11</oval:schema_version><oval:timestamp>2026-01-01T00:00:00</oval:timestamp></generator>
  <definitions>
    <definition id="oval:lab:def:1" version="1" class="compliance"><metadata><title>sshd forbids root login</title><description>PermitRootLogin must be no</description></metadata><criteria><criterion test_ref="oval:lab:tst:1"/></criteria></definition>
    <definition id="oval:lab:def:2" version="1" class="compliance"><metadata><title>faillock deny at most 5</title><description>deny</description></metadata><criteria><criterion test_ref="oval:lab:tst:2"/></criteria></definition>
    <definition id="oval:lab:def:3" version="1" class="compliance"><metadata><title>password max age</title><description>PASS_MAX_DAYS 90 or less</description></metadata><criteria><criterion test_ref="oval:lab:tst:3"/></criteria></definition>
  </definitions>
  <tests>
    <ind:textfilecontent54_test id="oval:lab:tst:1" version="1" check="all" check_existence="all_exist" comment="x"><ind:object object_ref="oval:lab:obj:1"/></ind:textfilecontent54_test>
    <ind:textfilecontent54_test id="oval:lab:tst:2" version="1" check="all" check_existence="all_exist" comment="x"><ind:object object_ref="oval:lab:obj:2"/></ind:textfilecontent54_test>
    <ind:textfilecontent54_test id="oval:lab:tst:3" version="1" check="all" check_existence="all_exist" comment="x"><ind:object object_ref="oval:lab:obj:3"/></ind:textfilecontent54_test>
  </tests>
  <objects>
    <ind:textfilecontent54_object id="oval:lab:obj:1" version="1"><ind:filepath>$PWD/host/etc/sshd_config</ind:filepath><ind:pattern operation="pattern match">^[\s]*PermitRootLogin[\s]+no[\s]*\$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>
    <ind:textfilecontent54_object id="oval:lab:obj:2" version="1"><ind:filepath>$PWD/host/etc/faillock.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*deny[\s]*=[\s]*[1-5][\s]*\$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>
    <ind:textfilecontent54_object id="oval:lab:obj:3" version="1"><ind:filepath>$PWD/host/etc/login.defs</ind:filepath><ind:pattern operation="pattern match">^PASS_MAX_DAYS[\s]+([0-9]|[1-8][0-9]|90)[\s]*\$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>
  </objects>
</oval_definitions>
X
cat > xccdf.xml <<'X'
<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_lab_benchmark_lab" resolved="1">
  <status>draft</status>
  <title>Lab benchmark</title>
  <description>Three host settings.</description>
  <version>1</version>
  <Profile id="xccdf_lab_profile_baseline">
    <title>Baseline</title><description>All rules.</description>
    <select idref="xccdf_lab_rule_ssh_root" selected="true"/>
    <select idref="xccdf_lab_rule_faillock" selected="true"/>
    <select idref="xccdf_lab_rule_maxdays" selected="true"/>
  </Profile>
  <Rule id="xccdf_lab_rule_ssh_root" selected="false" severity="high"><title>sshd forbids root login</title><description>PermitRootLogin must be no.</description><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="oval.xml" name="oval:lab:def:1"/></check></Rule>
  <Rule id="xccdf_lab_rule_faillock" selected="false" severity="medium"><title>faillock deny at most 5</title><description>deny must be 1 to 5.</description><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="oval.xml" name="oval:lab:def:2"/></check></Rule>
  <Rule id="xccdf_lab_rule_maxdays" selected="false" severity="low"><title>password max age</title><description>PASS_MAX_DAYS 90 or less.</description><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="oval.xml" name="oval:lab:def:3"/></check></Rule>
</Benchmark>
X
printf '# SPDX-License-Identifier: MIT\n# TODO: fill in each ?\nscan_command=?\nlist_profiles_command=?\nremediation_formats=?\nhighest_severity_failure=?\nwhy_tailor=?\n' > answers.txt
