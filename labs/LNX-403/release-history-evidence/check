#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
export LC_ALL=C
cd "${LAB_DIR:-.}"
exec python3 - <<'N'
import json, re, sys
SPEC = json.loads(r'''{"keys": [{"key": "weeks_observed", "type": "int", "min": 1, "max": 520, "hint": "integer, 4 or more to pass the rule below", "sample": "6"}, {"key": "releases", "type": "int", "min": 1, "max": 500, "hint": "integer", "sample": "3"}, {"key": "signed_releases", "type": "int", "min": 0, "max": 500, "hint": "integer", "sample": "3"}, {"key": "changelog_entries", "type": "int", "min": 0, "max": 5000, "hint": "integer", "sample": "14"}, {"key": "issues_opened", "type": "int", "min": 0, "max": 100000, "hint": "integer, 3 or more to pass the rule below", "sample": "7"}, {"key": "issues_closed", "type": "int", "min": 0, "max": 100000, "hint": "integer", "sample": "5"}, {"key": "median_first_response_hours", "type": "num", "min": 0, "max": 10000, "hint": "hours", "sample": "18"}, {"key": "regressions", "type": "int", "min": 0, "max": 1000, "hint": "integer", "sample": "1"}, {"key": "security_reports", "type": "int", "min": 0, "max": 1000, "hint": "integer", "sample": "0"}, {"key": "security_policy_published", "type": "yes", "must": "yes", "hint": "must be yes", "sample": "yes"}, {"key": "docs_changes_from_issues", "type": "int", "min": 0, "max": 1000, "hint": "integer", "sample": "3"}, {"key": "upgrade_path_tested", "type": "yes", "must": "yes", "hint": "must be yes", "sample": "yes"}], "rules": [{"name": "at least four weeks", "needs": ["weeks_observed"], "expr": "v['weeks_observed'] >= 4", "msg": "keep the service for at least four weeks"}, {"name": "real feedback", "needs": ["issues_opened"], "expr": "v['issues_opened'] >= 3", "msg": "at least three reports from other people (ask colleagues if needed)"}, {"name": "closed does not exceed opened", "needs": ["issues_opened", "issues_closed"], "expr": "v['issues_closed'] <= v['issues_opened']", "msg": "closed cannot exceed opened"}, {"name": "signed releases do not exceed releases", "needs": ["releases", "signed_releases"], "expr": "v['signed_releases'] <= v['releases']", "msg": "count only real releases"}, {"name": "every release was signed", "needs": ["releases", "signed_releases"], "expr": "v['signed_releases'] == v['releases']", "msg": "sign every release (or attest the build)"}, {"name": "regressions do not exceed issues", "needs": ["issues_opened", "regressions"], "expr": "v['regressions'] <= v['issues_opened']", "msg": "a regression is an issue"}]}''')
try:
    lines = open("evidence.txt").read().splitlines()
except OSError:
    print("FAIL: evidence.txt is missing; run setup"); sys.exit(1)
raw = {}
for ln in lines:
    if "=" in ln and not ln.lstrip().startswith("#"):
        k, v = ln.split("=", 1); raw[k.strip()] = v.strip()
bad = 0; v = {}
def fail(m):
    global bad; bad = 1; print("FAIL: " + m)
for k in SPEC["keys"]:
    key, t, val = k["key"], k["type"], raw.get(k["key"], "")
    try:
        if t == "int":
            x = int(val); assert k.get("min", -10**9) <= x <= k.get("max", 10**9)
        elif t == "num":
            x = float(val); assert k.get("min", -1e18) <= x <= k.get("max", 1e18)
        elif t == "enum":
            x = val; assert val in k["values"]
        elif t == "yes":
            x = val; assert val in ("yes", "no") and (k.get("must") is None or val == k["must"])
        elif t == "text":
            x = val; assert len(val) >= k.get("min", 3) and val != "?"
        v[key] = x; print("ok:   %s = %s" % (key, val))
    except (ValueError, AssertionError, KeyError):
        fail("%s: %s" % (key, k["hint"]))
for r in SPEC.get("rules", []):
    if all(r_k in v for r_k in r["needs"]):
        try:
            if eval(r["expr"], {"v": v}): print("ok:   " + r["name"])
            else: fail(r["name"] + ": " + r["msg"])
        except Exception as e:
            fail(r["name"] + ": " + str(e))
sys.exit(bad)
N
