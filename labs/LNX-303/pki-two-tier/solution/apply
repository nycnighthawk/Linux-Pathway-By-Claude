#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out inter.key 2>/dev/null
openssl req -new -key inter.key -subj "/O=Lab/CN=Lab Intermediate CA" -out inter.csr
openssl x509 -req -in inter.csr -CA root.pem -CAkey root.key -CAcreateserial -days 1825 \
  -extfile ca.cnf -extensions v3_inter -out inter.pem 2>/dev/null
mkdir -p db && : > db/index.txt && echo 1000 > db/serial && echo 1000 > db/crlnumber
for n in ok bad; do
  openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out $n.key 2>/dev/null
  openssl req -new -key $n.key -subj "/O=Lab/CN=$n.internal.example" -out $n.csr
  openssl ca -config ca.cnf -batch -notext -in $n.csr -out $n.pem 2>/dev/null
done
openssl ca -config ca.cnf -revoke bad.pem -crl_reason keyCompromise 2>/dev/null
openssl ca -config ca.cnf -gencrl -out crl.pem 2>/dev/null
