#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
python3 - <<'PY'
import csv, json, re
def key(v):
    a, _, b = v.partition("-")
    num = [int(x) if x.isdigit() else x for x in re.split(r"[.]", a)]
    rev = [int(x) for x in re.findall(r"\d+", b)] or [0]
    return ([(0, x) if isinstance(x, int) else (1, 0) for x in num], rev)
pk = [l.split() for l in open("packages.txt") if l.strip()]
inst = {n: v for n, v in pk}
json.dump({"bomFormat": "CycloneDX", "specVersion": "1.5", "version": 1,
           "components": [{"type": "library", "name": n, "version": v, "purl": "pkg:deb/debian/%s@%s" % (n, v)} for n, v in pk]},
          open("sbom.cdx.json", "w"), indent=2)
vex = {(x["cve"], x["package"]) for x in json.load(open("vex.json")) if x["status"] == "not_affected"}
rows = []
for a in json.load(open("advisories.json")):
    n = a["package"]
    if (a["cve"], n) in vex or n not in inst: continue
    if a["fixed"] is None or key(inst[n]) < key(a["fixed"]):
        rows.append((0 if a["kev"] else 1, {"CRITICAL": 0, "HIGH": 1, "MEDIUM": 2, "LOW": 3}[a["severity"]], a["cve"], n, inst[n], a["fixed"] or "unfixed", a["severity"], "yes" if a["kev"] else "no"))
rows.sort()
w = csv.writer(open("findings.csv", "w"))
w.writerow(["cve", "package", "installed", "fixed", "severity", "kev"])
for r in rows: w.writerow(r[2:])
PY
