set -eu
cat > web1.xml <<'XML'
<!-- SPDX-License-Identifier: GPL-2.0-only -->
<domain type='kvm'>
  <name>web1</name>
  <memory unit='GiB'>2</memory>
  <vcpu>2</vcpu>
  <os>
    <type arch='x86_64' machine='pc-q35-9.2'>hvm</type>
  </os>
  <cpu mode='host-model'/>
