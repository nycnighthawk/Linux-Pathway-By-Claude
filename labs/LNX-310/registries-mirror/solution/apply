#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > registries.conf <<'EOT'
# SPDX-License-Identifier: MIT
unqualified-search-registries = ["registry.example.com"]
short-name-mode = "enforcing"

[[registry]]
prefix = "docker.io"
location = "docker.io"

[[registry.mirror]]
location = "mirror.internal:5000/dockerhub"
pull-from-mirror = "digest-only"

[[registry]]
location = "registry.badvendor.example"
blocked = true
EOT
cat > copy.sh <<'EOT'
#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
skopeo copy --all --preserve-digests \
  docker://docker.io/library/alpine:3.21 \
  docker://mirror.internal:5000/base/alpine:3.21
EOT
cat > answers.txt <<'EOT'
# SPDX-License-Identifier: MIT
platform_count=3
arm64_digest=sha256:9f8e7d6c5b4a39281706f5e4d3c2b1a09f8e7d6c5b4a39281706f5e4d3c2b1a0
copy_needs_all=yes
EOT
