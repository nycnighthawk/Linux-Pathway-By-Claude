#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: a small SBOM with advisories, and empty VEX, verify and answers files.
set -eu
cd "${LAB_DIR:-.}"
rm -f sbom.cdx.json advisories.json answers.txt vex.json verify.sh
cat > sbom.cdx.json <<'EOT'
{"bomFormat": "CycloneDX", "specVersion": "1.5", "components": [
 {"type": "library", "name": "openssl", "version": "3.0.11", "purl": "pkg:deb/debian/openssl@3.0.11-1~deb12u1",
  "properties": [{"name": "distro.patched", "value": "CVE-2026-1111"}]},
 {"type": "application", "name": "busybox", "version": "1.36.1", "purl": "pkg:deb/debian/busybox@1.36.1-6"},
 {"type": "library", "name": "curl", "version": "8.5.0", "purl": "pkg:deb/debian/curl@8.5.0-2"},
 {"type": "library", "name": "libxml2", "version": "2.9.14", "purl": "pkg:deb/debian/libxml2@2.9.14-1"}
]}
EOT
cat > advisories.json <<'EOT'
[{"cve": "CVE-2026-1111", "name": "openssl", "fixed_in": "3.0.12", "severity": "HIGH"},
 {"cve": "CVE-2026-2222", "name": "busybox", "fixed_in": "1.37.0", "severity": "CRITICAL"},
 {"cve": "CVE-2026-3333", "name": "curl", "fixed_in": "8.5.0", "severity": "MEDIUM"},
 {"cve": "CVE-2026-4444", "name": "libxml2", "fixed_in": "2.10.0", "severity": "HIGH"}]
EOT
echo '{}' > vex.json
printf '#!/usr/bin/env bash\n# SPDX-License-Identifier: MIT\n# TODO: cosign verify with identity and issuer\n' > verify.sh
printf '# SPDX-License-Identifier: MIT\nvulnerable=?\nsign_target=?\n' > answers.txt
