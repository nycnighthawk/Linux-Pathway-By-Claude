set -eu
cd "${LAB_DIR:-.}"
python3 - <<'N'
s = open("armimg.py").read()
s = s.replace("    # TODO\n    raise NotImplementedError", '''    if len(data) < 64:
        raise ValueError("too short for an arm64 Image header")
    code0, code1, text_offset, image_size, flags, _r2, _r3, _r4, magic, _r5 = struct.unpack_from("<IIQQQQQQII", data, 0)
    if magic != 0x644d5241:
        raise ValueError("bad magic")
    return {
        "text_offset": text_offset,
        "image_size": image_size,
        "big_endian": bool(flags & 1),
        "page_size": PAGE_SIZES[(flags >> 1) & 3],
        "placement_anywhere": bool(flags & 8),
    }''')
open("armimg.py", "w").write(s)
N
