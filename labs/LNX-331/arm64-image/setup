#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -eu
cd "${LAB_DIR:-.}"
python3 - <<'N'
import struct
def image(text_offset, size, flags, magic=b"ARM\x64"):
    hdr = struct.pack("<IIQQQQQQ4sI", 0x14000040, 0, text_offset, size, flags, 0, 0, 0, magic, 0)
    assert len(hdr) == 64
    return hdr + b"\0" * 64
open("Image.a", "wb").write(image(0, 0x1a40000, (1 << 1) | (1 << 3)))          # LE, 4K pages, placement anywhere
open("Image.b", "wb").write(image(0x80000, 0x2100000, (3 << 1)))               # LE, 64K pages, near RAM base
open("Image.c", "wb").write(image(0, 0x900000, 1 | (2 << 1) | (1 << 3)))       # BE, 16K pages
open("Image.bad", "wb").write(image(0, 0x100000, 0, magic=b"XXXX"))            # not an arm64 Image
N
cat > armimg.py <<'N'
# SPDX-License-Identifier: GPL-2.0-only
"""Parse the 64-byte header of an arm64 kernel Image (Documentation/arch/arm64/booting.rst).

Little-endian layout, 64 bytes:
  offset  0  u32 code0      (executable code: a branch to the stext entry)
  offset  4  u32 code1
  offset  8  u64 text_offset (offset from the 2 MiB aligned base where the image wants to be loaded)
  offset 16  u64 image_size  (effective size of the kernel image, including BSS)
  offset 24  u64 flags
  offset 32  u64 res2, 40 u64 res3, 48 u64 res4  (reserved)
  offset 56  u32 magic = 0x644d5241   (the bytes "ARM" then 0x64)
  offset 60  u32 res5

flags:
  bit 0     kernel endianness: 0 little, 1 big
  bits 1-2  kernel page size: 0 unspecified, 1 4K, 2 16K, 3 64K
  bit 3     physical placement: 0 = base is 2 MiB aligned near the start of RAM,
            1 = the image may be placed anywhere in memory
(Check the exact bit meanings against the booting document of your kernel version; to verify.)
"""
import struct

PAGE_SIZES = {0: None, 1: 4096, 2: 16384, 3: 65536}


def parse_header(data):
    """Return a dict with keys: text_offset, image_size, big_endian (bool),
    page_size (bytes or None), placement_anywhere (bool).
    Raise ValueError if the data is too short or the magic is wrong."""
    # TODO
    raise NotImplementedError
N
