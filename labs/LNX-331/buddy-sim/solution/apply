set -eu
cd "${LAB_DIR:-.}"
python3 - <<'N'
s = open("buddy.py").read()
a = s.index("        # TODO\n        return None")
s = s.replace("        # TODO\n        return None", '''        for o in range(order, MAX_ORDER + 1):
            if self.free[o]:
                pfn = min(self.free[o])
                self.free[o].remove(pfn)
                while o > order:
                    o -= 1
                    self.free[o].add(pfn + (1 << o))
                return pfn
        return None''')
s = s.replace("        # TODO\n        pass", '''        while order < MAX_ORDER:
            buddy = pfn ^ (1 << order)
            if buddy not in self.free[order]:
                break
            self.free[order].remove(buddy)
            pfn = min(pfn, buddy)
            order += 1
        self.free[order].add(pfn)''')
open("buddy.py", "w").write(s)
N
