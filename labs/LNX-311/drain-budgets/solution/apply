#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
python3 - <<'PY'
import yaml
docs = [d for d in yaml.safe_load_all(open("apps.yaml")) if d]
for d in docs:
    if d["kind"] == "PodDisruptionBudget" and d["metadata"]["name"] == "web":
        d["spec"] = {"maxUnavailable": 1, "selector": d["spec"]["selector"]}
    if d["kind"] == "PodDisruptionBudget" and d["metadata"]["name"] == "db":
        d["spec"]["maxUnavailable"] = 1
    if d["kind"] == "Deployment":
        d["spec"]["template"]["spec"]["topologySpreadConstraints"] = [{"maxSkew": 1, "topologyKey": "kubernetes.io/hostname", "whenUnsatisfiable": "DoNotSchedule", "labelSelector": {"matchLabels": {"app": "web"}}}]
yaml.safe_dump_all(docs, open("apps.yaml", "w"))
PY
printf '%s\n' "etcd snapshot" "upgrade kubeadm package" "kubeadm upgrade plan" "kubeadm upgrade apply" "kubectl drain" "upgrade kubelet and kubectl packages" "restart kubelet" "kubectl uncordon" > runbook.txt
