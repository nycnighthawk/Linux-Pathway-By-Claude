#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
rm -rf fakebin backups calls.log
mkdir -p fakebin backups
cat > fakebin/etcdctl <<'F'
#!/usr/bin/env bash
echo "etcdctl $*" >> "${CALLS_LOG:-calls.log}"
[ "${FAKE_FAIL:-0}" = 1 ] && exit 1
for a in "$@"; do last=$a; done
case " $* " in *" snapshot save "*) echo snapshot-data > "$last";; esac
F
cat > fakebin/etcdutl <<'F'
#!/usr/bin/env bash
echo "etcdutl $*" >> "${CALLS_LOG:-calls.log}"
F
chmod +x fakebin/etcdctl fakebin/etcdutl
touch -d '10 days ago' backups/etcd-old.db
touch -d '1 day ago' backups/etcd-recent.db
printf '#!/usr/bin/env bash\n# TODO: write the backup\nexit 0\n' > etcd-backup.sh
chmod +x etcd-backup.sh
