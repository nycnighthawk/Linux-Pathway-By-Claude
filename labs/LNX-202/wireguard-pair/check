#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Check keys, file modes and the two configurations of a site-to-site WireGuard tunnel (no kernel support needed).
set -u
export LC_ALL=C
cd "${LAB_DIR:-.}"
bad=0
fail() { echo "FAIL: $*"; bad=1; }
ok() { echo "ok:   $*"; }
command -v wg >/dev/null && command -v wg-quick >/dev/null || { echo "FAIL: wg and wg-quick are not installed (package wireguard-tools)"; exit 1; }
for f in a.key b.key a.conf b.conf; do [ -f "$f" ] || { echo "FAIL: $f does not exist yet"; exit 1; }; done
for f in a.key b.key a.conf b.conf; do
  m=$(stat -c %a "$f")
  case "$m" in 600|400) ok "$f has mode $m" ;; *) fail "$f has mode $m; it holds a secret, use chmod 600 (or umask 077)" ;; esac
done
for k in a b; do
  if wg pubkey < "$k.key" >/dev/null 2>&1; then ok "$k.key is a valid private key"; else fail "$k.key is not a valid private key (wg genkey)"; fi
done
[ "$bad" -eq 0 ] || exit 1
code=$(cat <<'PY'
import configparser, subprocess, sys

def pub(keyfile):
    return subprocess.run(["wg", "pubkey"], stdin=open(keyfile), capture_output=True, text=True).stdout.strip()

def load(path):
    cp = configparser.ConfigParser(strict=False, interpolation=None, delimiters=("=",), allow_no_value=True)
    cp.optionxform = str
    cp.read(path)
    return cp

bad = 0
def fail(m):
    global bad
    print("FAIL: " + m); bad = 1
def ok(m): print("ok:   " + m)

def g(cp, s, k):
    return cp.get(s, k, fallback="").strip()

a, b = load("a.conf"), load("b.conf")
keys = {"a": open("a.key").read().strip(), "b": open("b.key").read().strip()}
for name, cp, other, want_addr, want_port, want_allowed, want_ep in (
    ("a", a, "b", "10.77.0.1/24", "51820", {"10.77.0.2/32", "192.168.20.0/24"}, "203.0.113.2:51821"),
    ("b", b, "a", "10.77.0.2/24", "51821", {"10.77.0.1/32", "192.168.10.0/24"}, "198.51.100.1:51820"),
):
    f = name + ".conf"
    if g(cp, "Interface", "PrivateKey") == keys[name]: ok(f + ": PrivateKey matches " + name + ".key")
    else: fail(f + ": PrivateKey must be the content of " + name + ".key")
    if g(cp, "Interface", "Address") == want_addr: ok(f + ": Address " + want_addr)
    else: fail(f + ": Address must be " + want_addr)
    if g(cp, "Interface", "ListenPort") == want_port: ok(f + ": ListenPort " + want_port)
    else: fail(f + ": ListenPort must be " + want_port)
    if g(cp, "Interface", "MTU") == "1420": ok(f + ": MTU 1420")
    else: fail(f + ": set MTU = 1420")
    if g(cp, "Peer", "PublicKey") == pub(other + ".key"): ok(f + ": the peer's PublicKey is derived from " + other + ".key")
    else: fail(f + ": [Peer] PublicKey must be the public key of " + other + ".key (wg pubkey < " + other + ".key)")
    allowed = {x.strip() for x in g(cp, "Peer", "AllowedIPs").split(",") if x.strip()}
    if allowed == want_allowed: ok(f + ": AllowedIPs " + ", ".join(sorted(allowed)))
    else: fail(f + ": AllowedIPs must be exactly " + ", ".join(sorted(want_allowed)) + " (the peer's tunnel address and its LAN)")
    if g(cp, "Peer", "Endpoint") == want_ep: ok(f + ": Endpoint " + want_ep)
    else: fail(f + ": Endpoint must be " + want_ep)
    if g(cp, "Peer", "PersistentKeepalive") == "25": ok(f + ": PersistentKeepalive 25")
    else: fail(f + ": set PersistentKeepalive = 25")
    r = subprocess.run(["wg-quick", "strip", "./" + f], capture_output=True, text=True)
    if r.returncode == 0 and "[Peer]" in r.stdout: ok(f + ": wg-quick strip parses the file")
    else: fail(f + ": wg-quick strip fails: " + r.stderr.strip()[:120])
if g(a, "Interface", "PrivateKey") == g(b, "Interface", "PrivateKey"): fail("both nodes use the same private key; generate two key pairs")
sys.exit(bad)
PY
)
python3 -c "$code" || bad=1
exit "$bad"
