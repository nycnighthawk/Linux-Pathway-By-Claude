#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > haproxy.cfg <<'CONF'
# SPDX-License-Identifier: MIT
global
    maxconn 200

defaults
    mode http
    timeout connect 2s
    timeout client  10s
    timeout server  10s

frontend web
    bind 127.0.0.1:8080
    default_backend app

backend app
    balance roundrobin
    option httpchk GET /health
    server app1 127.0.0.1:8081 check inter 1s fall 2 rise 2
    server app2 127.0.0.1:8082 check inter 1s fall 2 rise 2
CONF
cat > keepalived.conf <<'CONF'
# SPDX-License-Identifier: MIT
global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_haproxy {
    script "/usr/bin/pgrep haproxy"
    interval 2
    weight -30
    fall 2
    rise 2
}

vrrp_instance VI_1 {
    state BACKUP
    interface eth0
    virtual_router_id 51
    priority 110
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass s3cret
    }
    virtual_ipaddress {
        192.0.2.80/24 dev eth0
    }
    track_script {
        chk_haproxy
    }
}
CONF
