#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO=sudo
$SUDO ip link set lab-br0 type bridge vlan_filtering 1
for p in lab-pa lab-pb; do $SUDO bridge vlan add dev "$p" vid 10 pvid untagged; $SUDO bridge vlan del dev "$p" vid 1; done
$SUDO bridge vlan add dev lab-pc vid 20 pvid untagged
$SUDO bridge vlan del dev lab-pc vid 1
cat > bond0.netdev <<'U'
# SPDX-License-Identifier: MIT
[NetDev]
Name=bond0
Kind=bond

[Bond]
Mode=802.3ad
TransmitHashPolicy=layer3+4
LACPTransmitRate=fast
MIIMonitorSec=100ms
U
cat > ports.network <<'U'
# SPDX-License-Identifier: MIT
[Match]
Name=enp7s0 enp8s0

[Network]
Bond=bond0
U
