#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -eu
cd "${LAB_DIR:-.}"
cat > wwwdata.res <<'X'
# SPDX-License-Identifier: GPL-2.0-only
resource "wwwdata" {
  device minor 1;
  meta-disk internal;
  net {
    protocol C;
    fencing resource-and-stonith;
    verify-alg sha1;
  }
  handlers {
    fence-peer "/usr/lib/drbd/crm-fence-peer.9.sh";
    unfence-peer "/usr/lib/drbd/crm-unfence-peer.9.sh";
  }
  on "node1" {
    disk "/dev/vg0/data";
    node-id 0;
  }
  on "node2" {
    disk "/dev/vg0/data";
    node-id 1;
  }
  connection {
    host "node1" address 192.168.122.11:7789;
    host "node2" address 192.168.122.12:7789;
  }
}
X
cat > drbd-pcs.sh <<'X'
#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -eu
pcs cluster cib drbd_cfg
pcs -f drbd_cfg resource create WebData ocf:linbit:drbd drbd_resource=wwwdata \
    op monitor interval=29s role=Promoted monitor interval=31s role=Unpromoted
pcs -f drbd_cfg resource promotable WebData promoted-max=1 promoted-node-max=1 clone-max=2 clone-node-max=1 notify=true
pcs -f drbd_cfg resource create WebFS Filesystem device=/dev/drbd1 directory=/srv/www fstype=xfs
pcs -f drbd_cfg constraint colocation add WebFS with Promoted WebData-clone INFINITY
pcs -f drbd_cfg constraint order promote WebData-clone then start WebFS
pcs cluster cib-push drbd_cfg --config
X
chmod +x drbd-pcs.sh
