#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Inspect the built packages with rpm queries.
set -u
export LC_ALL=C
cd "${LAB_DIR:-.}"
command -v rpm >/dev/null && command -v rpmbuild >/dev/null || { echo "FAIL: install the rpm package (rpm, rpmbuild)"; exit 1; }
[ -f hello-site-1.0.tar.gz ] || { echo "FAIL: run setup first"; exit 1; }
bad=0
ok()   { echo "ok:   $1"; }
fail() { echo "FAIL: $1"; bad=1; }
rpmf=$(ls rpmbuild/RPMS/noarch/hello-site-1.0-*.rpm 2>/dev/null | head -1)
srpm=$(ls rpmbuild/SRPMS/hello-site-1.0-*.src.rpm 2>/dev/null | head -1)
[ -n "$rpmf" ] && ok "binary RPM built: $(basename "$rpmf")" || fail "no noarch binary RPM in rpmbuild/RPMS/noarch (rpmbuild --define \"_topdir \$PWD/rpmbuild\" -ba ...)"
[ -n "$srpm" ] && ok "source RPM built: $(basename "$srpm")" || fail "no source RPM in rpmbuild/SRPMS (use -ba, not -bb)"
[ -n "$rpmf" ] || exit 1
q() { rpm -qp --nosignature --qf "$1" "$rpmf" 2>/dev/null; }
[ "$(q '%{NAME}')" = hello-site ] && ok "Name hello-site" || fail "Name must be hello-site"
[ "$(q '%{VERSION}')" = 1.0 ] && ok "Version 1.0" || fail "Version must be 1.0"
[ "$(q '%{LICENSE}')" = MIT ] && ok "License MIT" || fail "License must be MIT"
[ "$(q '%{ARCH}')" = noarch ] && ok "BuildArch noarch" || fail "package contains no compiled code: BuildArch: noarch"
files=$(rpm -qp --nosignature -l "$rpmf" 2>/dev/null)
echo "$files" | grep -qx /usr/bin/hello-site && ok "/usr/bin/hello-site is packaged" || fail "package /usr/bin/hello-site (use %{_bindir})"
echo "$files" | grep -qx /etc/hello-site.conf && ok "/etc/hello-site.conf is packaged" || fail "package /etc/hello-site.conf (use %{_sysconfdir})"
rpm -qp --nosignature -c "$rpmf" 2>/dev/null | grep -qx /etc/hello-site.conf && ok "the config file is flagged %config" || fail "mark the config file with %config(noreplace)"
rpm -qp --nosignature --qf '[%{FILEFLAGS:fflags} %{FILENAMES}\n]' "$rpmf" 2>/dev/null | grep -E "^[a-z]*n[a-z]* /etc/hello-site.conf" >/dev/null && ok "noreplace: local edits survive an upgrade" || fail "use %config(noreplace), not plain %config"
rpm -qp --nosignature -L "$rpmf" 2>/dev/null | grep -q LICENSE && ok "LICENSE is marked with %license" || fail "install the license with %license LICENSE"
mode=$(rpm -qp --nosignature --qf '[%{FILEMODES:perms} %{FILENAMES}\n]' "$rpmf" | grep " /usr/bin/hello-site$" | cut -d' ' -f1)
case "$mode" in -rwxr-xr-x) ok "script is mode 0755" ;; *) fail "/usr/bin/hello-site must be mode 0755 (found $mode)" ;; esac
spec=$(ls hello-site.spec rpmbuild/SPECS/hello-site.spec 2>/dev/null | head -1)
[ -n "$spec" ] && grep -q "^%check" "$spec" && ok "the spec runs a %check" || fail "add a %check section that runs the script"
[ -n "$spec" ] && grep -q "%{?dist}" "$spec" && ok "Release carries %{?dist}" || fail "Release should end with %{?dist}"
[ -n "$spec" ] && grep -q "^%changelog" "$spec" && ok "spec has a changelog" || fail "add a %changelog entry"
exit $bad
