#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
for c in a b; do
cat > kind-$c.yaml <<J
# SPDX-License-Identifier: MIT
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  podSubnet: 10.244.0.0/16
J
printf '%s\n' '# SPDX-License-Identifier: MIT' 'routingMode: native' > values-$c.yaml
done
printf '%s\n' '# SPDX-License-Identifier: MIT' 'apiVersion: v1' 'kind: Service' 'metadata:' '  name: rebel-base' 'spec:' '  ports: [{port: 80}]' > rebel-base.yaml
