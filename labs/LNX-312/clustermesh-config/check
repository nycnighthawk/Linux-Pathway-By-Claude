#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
cd "${LAB_DIR:-.}"
python3 - <<'PY'
import ipaddress, sys, yaml
bad = 0
def chk(c, m):
    global bad
    print(("ok:   " if c else "FAIL: ") + m)
    if not c: bad = 1
def g(d, *k):
    for x in k:
        if not isinstance(d, dict): return None
        d = d.get(x)
    return d
try:
    ka, kb = (yaml.safe_load(open(f"kind-{c}.yaml")) for c in "ab")
    for n, k in (("a", ka), ("b", kb)):
        chk(k.get("kind") == "Cluster" and g(k, "networking", "disableDefaultCNI") is True, f"kind-{n} disables the default CNI")
    pa, pb = (ipaddress.ip_network(g(k, "networking", "podSubnet") or "0.0.0.0/32") for k in (ka, kb))
    chk(not pa.overlaps(pb), "Pod subnets do not overlap")
    chk(g(ka, "networking", "podSubnet") == "10.1.0.0/16" and g(kb, "networking", "podSubnet") == "10.2.0.0/16", "Pod subnets as specified")
    chk(g(ka, "networking", "serviceSubnet") == "10.96.0.0/12" and g(kb, "networking", "serviceSubnet") == "10.97.0.0/12", "Service subnets as specified")
    va, vb = (yaml.safe_load(open(f"values-{c}.yaml")) for c in "ab")
    chk(g(va, "cluster", "name") == "mesh-a" and g(vb, "cluster", "name") == "mesh-b", "unique cluster names")
    chk(g(va, "cluster", "id") == 1 and g(vb, "cluster", "id") == 2, "unique cluster ids")
    for n, v in (("a", va), ("b", vb)):
        chk(v.get("routingMode") == "tunnel", f"values-{n}: tunnel routing")
        chk(g(v, "clustermesh", "useAPIServer") is True, f"values-{n}: mesh API server on")
        chk(g(v, "clustermesh", "apiserver", "service", "type") == "NodePort", f"values-{n}: API server exposed as NodePort")
    s = yaml.safe_load(open("rebel-base.yaml"))
    a = g(s, "metadata", "annotations") or {}
    chk(s.get("kind") == "Service" and s["metadata"]["name"] == "rebel-base", "Service rebel-base")
    chk(a.get("service.cilium.io/global") == "true", "Service is global")
    chk(a.get("service.cilium.io/affinity") == "local", "affinity local")
except Exception as e:
    print("FAIL:", repr(e)); bad = 1
sys.exit(bad)
PY
