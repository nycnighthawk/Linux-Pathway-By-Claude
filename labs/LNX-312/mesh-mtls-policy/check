#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
cd "${LAB_DIR:-.}"
python3 - <<'PY'
import sys, yaml
bad = 0
def chk(c, m):
    global bad
    print(("ok:   " if c else "FAIL: ") + m)
    if not c: bad = 1
try:
    docs = [d for d in yaml.safe_load_all(open("mesh.yaml")) if d]
    by = lambda k: [d for d in docs if d.get("kind") == k]
    ns = [d for d in by("Namespace") if d["metadata"]["name"] == "billing"]
    chk(bool(ns) and ns[0]["metadata"].get("labels", {}).get("istio.io/dataplane-mode") == "ambient", "namespace billing labelled ambient")
    pa = by("PeerAuthentication")
    chk(len(pa) == 1 and pa[0]["metadata"]["name"] == "default" and pa[0]["metadata"]["namespace"] == "billing", "PeerAuthentication billing/default")
    chk(bool(pa) and pa[0]["spec"].get("mtls", {}).get("mode") == "STRICT" and "selector" not in pa[0]["spec"], "STRICT and namespace-wide")
    ap = [d for d in by("AuthorizationPolicy") if d["metadata"]["name"] == "billing-from-checkout"]
    chk(bool(ap) and ap[0]["metadata"]["namespace"] == "billing", "AuthorizationPolicy billing/billing-from-checkout")
    s = ap[0]["spec"] if ap else {}
    chk(s.get("selector", {}).get("matchLabels") == {"app": "billing"}, "selects app: billing")
    chk(s.get("action", "ALLOW") == "ALLOW", "action ALLOW")
    r = (s.get("rules") or [{}])
    chk(len(r) == 1 and r[0].get("from", [{}])[0].get("source", {}).get("principals") == ["cluster.local/ns/shop/sa/checkout"], "only the checkout principal")
    chk(r[0].get("to", [{}])[0].get("operation", {}).get("ports") == ["8080"], "only port 8080")
except Exception as e:
    print("FAIL:", repr(e)); bad = 1
sys.exit(bad)
PY
