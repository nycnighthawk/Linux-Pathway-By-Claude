#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
cd "${LAB_DIR:-.}"
python3 - <<'PY'
import sys, yaml
bad = 0
def chk(c, m):
    global bad
    print(("ok:   " if c else "FAIL: ") + m)
    if not c: bad = 1
try:
    g = yaml.safe_load(open("gateway.yaml"))
    chk(g["kind"] == "Gateway" and g["metadata"]["name"] == "edge" and g["metadata"]["namespace"] == "infra", "Gateway infra/edge")
    ls = g["spec"].get("listeners") or []
    l = next((x for x in ls if x.get("name") == "https"), {})
    chk(l.get("port") == 443 and l.get("protocol") == "HTTPS", "listener https on 443/HTTPS")
    chk(l.get("hostname") == "*.example.test", "listener hostname")
    t = l.get("tls", {})
    chk(t.get("mode") == "Terminate" and any(r.get("name") == "edge-cert" for r in t.get("certificateRefs", [])), "TLS terminates with edge-cert")
    ns = (l.get("allowedRoutes") or {}).get("namespaces", {})
    chk(ns.get("from") == "Selector" and ns.get("selector", {}).get("matchLabels", {}).get("edge-access") == "true", "routes allowed from labelled namespaces")
    r = yaml.safe_load(open("route.yaml"))
    chk(r["kind"] == "HTTPRoute" and r["metadata"]["namespace"] == "shop", "HTTPRoute in shop")
    pr = (r["spec"].get("parentRefs") or [{}])[0]
    chk(pr.get("name") == "edge" and pr.get("namespace") == "infra", "parent is infra/edge")
    chk(r["spec"].get("hostnames") == ["shop.example.test"], "hostname")
    canary = split = False
    for rule in r["spec"].get("rules", []):
        refs = {b["name"]: b.get("weight") for b in rule.get("backendRefs", [])}
        hdr = any(h.get("name") == "x-canary" and h.get("value") == "always"
                  for m in rule.get("matches", []) for h in m.get("headers", []))
        if hdr and list(refs) == ["shop-v2"]: canary = True
        if refs == {"shop-v1": 90, "shop-v2": 10} and not hdr: split = True
    chk(split, "90/10 split between shop-v1 and shop-v2")
    chk(canary, "header x-canary: always goes only to shop-v2")
except Exception as e:
    print("FAIL:", repr(e)); bad = 1
sys.exit(bad)
PY
