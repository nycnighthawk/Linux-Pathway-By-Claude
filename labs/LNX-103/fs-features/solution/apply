#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
export PATH="$PATH:/usr/sbin:/sbin"
truncate -s 128M ext4.img && mkfs.ext4 -q -L data -m 1 -O ^has_journal ext4.img
truncate -s 320M xfs.img && mkfs.xfs -q -L logs -m reflink=0 xfs.img
eu=$(dumpe2fs -h ext4.img 2>/dev/null | awk -F': *' '/^Filesystem UUID/ {print $2}')
xu=$(xfs_db -r -c 'sb 0' -c 'p' xfs.img | awk '/^uuid =/ {print $3}')
printf 'UUID=%s /srv/data ext4 noatime,nodev,nofail 0 2\nUUID=%s /srv/logs xfs nodev,nosuid,noexec,nofail 0 0\n' "$eu" "$xu" > fstab
name=$(systemd-escape -p --suffix=mount /srv/data)
printf '[Unit]\nDescription=Data volume\n\n[Mount]\nWhat=/dev/disk/by-uuid/%s\nWhere=/srv/data\nType=ext4\nOptions=noatime,nodev\n\n[Install]\nWantedBy=local-fs.target\n' "$eu" > "units/$name"
sed -i -e 's/^xfs_grow_command=.*/xfs_grow_command=xfs_growfs/' -e 's/^xfs_can_shrink=.*/xfs_can_shrink=no/' -e 's/^xfs_geometry_command=.*/xfs_geometry_command=xfs_info/' answers.txt
