set -eu
cd "${LAB_DIR:-.}"
printf '/srv/export/projects 192.168.10.0/24(rw,sync,no_subtree_check,root_squash)\n/srv/export/docs *.example.com(ro,sync,no_subtree_check)\n' > exports
printf 'files.example.com:/export/home /mnt/home nfs4 rw,sec=sys,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=600 0 0\n//files.example.com/team /mnt/team cifs credentials=/root/.smbcred,uid=1000,gid=1000,vers=3.1.1,_netdev,nofail 0 0\n' > fstab
printf '/home /etc/auto.home --timeout=600\n' > auto.master
printf '* -fstype=nfs4,rw,sec=sys,nosuid files.example.com:/export/home/&\n' > auto.home
install -m 600 /dev/null smbcred
printf 'username=alice\npassword=changeme\ndomain=EXAMPLE\n' > smbcred
sed -i -e 's/^nfs_default_failure_mode=.*/nfs_default_failure_mode=hard/' -e 's/^nfsv4_tcp_port=.*/nfsv4_tcp_port=2049/' -e 's/^kerberos_encrypting_flavour=.*/kerberos_encrypting_flavour=krb5p/' answers.txt
