#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
T=iqn.2025-06.lab.example:san.lun1
I=iqn.2025-06.lab.example:compute1
cat > target.cli <<EOF
backstores/block create name=lun1 dev=/dev/vg0/lun1
iscsi/ create $T
iscsi/$T/tpg1/luns create /backstores/block/lun1
iscsi/$T/tpg1/acls create $I
iscsi/$T/tpg1/portals create 192.0.2.10 3260
saveconfig
EOF
printf 'InitiatorName=%s\n' "$I" > initiatorname.iscsi
install -m 600 /dev/null iscsid.conf
printf 'node.startup = automatic\nnode.session.timeo.replacement_timeout = 5\nnode.session.auth.authmethod = CHAP\nnode.session.auth.username = lab\nnode.session.auth.password = changeme\n' > iscsid.conf
printf 'UUID=0c1d4a02-5b1e-4a77-9a6d-2f1b3c4d5e6f /srv/san xfs defaults,_netdev,nofail 0 0\n' > fstab
sed -i -e 's/^iscsi_tcp_port=.*/iscsi_tcp_port=3260/' -e 's/^initiator_daemon=.*/initiator_daemon=iscsid/' -e 's/^name_prefix=.*/name_prefix=iqn/' answers.txt
