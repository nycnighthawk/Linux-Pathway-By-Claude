#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: captured evidence from a degraded array, a blank answer sheet.
set -eu
cd "${LAB_DIR:-.}"
rm -f mdadm.conf runbook.txt answers.txt mdstat.txt detail.txt
cat > mdstat.txt <<'EOF'
Personalities : [raid6] [raid5] [raid4]
md0 : active raid5 sdb1[1] sda1[0]
      1953260544 blocks super 1.2 level 5, 512k chunk, algorithm 2 [3/2] [UU_]
      bitmap: 1/8 pages [4KB], 65536KB chunk

unused devices: <none>
EOF
cat > detail.txt <<'EOF'
/dev/md0:
           Version : 1.2
     Creation Time : Mon Mar  3 09:12:44 2025
        Raid Level : raid5
        Array Size : 1953260544 (1862.77 GiB 2000.14 GB)
     Used Dev Size : 976630272 (931.39 GiB 1000.07 GB)
      Raid Devices : 3
     Total Devices : 3
       Persistence : Superblock is persistent

     Intent Bitmap : Internal

       Update Time : Sat Nov  8 22:41:03 2025
             State : clean, degraded
    Active Devices : 2
   Working Devices : 2
    Failed Devices : 1
     Spare Devices : 0

            Layout : left-symmetric
        Chunk Size : 512K

Consistency Policy : bitmap

              Name : fileserver:0  (local to host fileserver)
              UUID : 3c1f9d06:0b6a7e2d:8a24f6b5:11c9d7aa
            Events : 48211

    Number   Major   Minor   RaidDevice State
       0       8        1        0      active sync   /dev/sda1
       1       8       17        1      active sync   /dev/sdb1
       -       0        0        2      removed

       2       8       33        -      faulty   /dev/sdc1
EOF
printf '# SPDX-License-Identifier: MIT\n# TODO: fill in each ?\nraid_level=?\nfailed_device=?\nfailures_survived=?\nmdstat_status=?\n' > answers.txt
