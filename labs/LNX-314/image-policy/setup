#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
mkdir -p fixtures
python3 - <<'P'
import json
def sbom(*comps):
    return {"bomFormat": "CycloneDX", "specVersion": "1.5", "components": [
        {"type": "library", "name": n, "version": v, "licenses": [{"license": {"id": l}}]} for n, v, l in comps]}
json.dump(sbom(("log4j-core", "2.20.0", "Apache-2.0"), ("zlib", "1.3.1", "Zlib")), open("fixtures/good.json", "w"))
json.dump(sbom(("log4j-core", "2.14.1", "Apache-2.0"), ("zlib", "1.3.1", "Zlib")), open("fixtures/old-log4j.json", "w"))
json.dump(sbom(("log4j-core", "2.9.0", "Apache-2.0")), open("fixtures/old-log4j-2.9.json", "w"))
json.dump(sbom(("libfoo", "1.0.0", "GPL-3.0-only"), ("zlib", "1.3.1", "Zlib")), open("fixtures/gpl.json", "w"))
json.dump({"bomFormat": "CycloneDX", "specVersion": "1.5", "components": [{"type": "library", "name": "mystery", "version": "0.1"}]}, open("fixtures/no-licence.json", "w"))
P
[ -f sbom_gate.py ] || cat > sbom_gate.py <<'N'
#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# usage: sbom_gate.py sbom.json  -> exit 0 if the SBOM passes the policy, exit 1 (and print why) otherwise
# Policy: log4j-core must be 2.17.1 or newer (compare numbers, not strings); no GPL-3.0-only / GPL-3.0-or-later /
# AGPL-3.0-only component; every component must declare a licence.
import sys
sys.exit(0)  # TODO
N
chmod +x sbom_gate.py
[ -f deploy.yaml ] || cat > deploy.yaml <<'N'
# SPDX-License-Identifier: MIT
apiVersion: apps/v1
kind: Deployment
metadata: {name: shop, namespace: prod}
spec:
  replicas: 2
  selector: {matchLabels: {app: shop}}
  template:
    metadata: {labels: {app: shop}}
    spec:
      containers:
        - name: shop
          image: registry.example/shop:1.4
N
[ -f policy.yaml ] || echo "# TODO: Kyverno ClusterPolicy with a verifyImages rule" > policy.yaml
