#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
python3 - <<'P'
import re
s = open("workloads.yaml").read()
s = s.replace("    spec:\n      containers: [{name: api,", "    spec:\n      serviceAccountName: api\n      containers: [{name: api,")
s = s.replace("    spec:\n      containers: [{name: web,", "    spec:\n      serviceAccountName: web\n      containers: [{name: web,")
open("workloads.yaml", "w").write(s)
P
cat > peerauth.yaml <<'N'
# SPDX-License-Identifier: MIT
apiVersion: security.istio.io/v1
kind: PeerAuthentication
metadata: {name: default, namespace: db}
spec:
  mtls: {mode: STRICT}
N
cat > authz.yaml <<'N'
# SPDX-License-Identifier: MIT
apiVersion: security.istio.io/v1
kind: AuthorizationPolicy
metadata: {name: db-allow, namespace: db}
spec:
  selector: {matchLabels: {app: db}}
  action: ALLOW
  rules:
    - from: [{source: {principals: ["cluster.local/ns/shop/sa/api"]}}]
      to: [{operation: {ports: ["5432"]}}]
    - from: [{source: {principals: ["cluster.local/ns/monitoring/sa/prometheus"]}}]
      to: [{operation: {ports: ["9187"]}}]
N
