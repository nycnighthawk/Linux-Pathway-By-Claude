#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > runtimeclass.yaml <<'N'
# SPDX-License-Identifier: MIT
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata: {name: gvisor}
handler: runsc
overhead:
  podFixed: {cpu: 250m, memory: 120Mi}
scheduling:
  nodeSelector: {sandbox: gvisor}
  tolerations:
    - {key: sandbox, operator: Equal, value: gvisor, effect: NoSchedule}
N
sed -i 's/^spec:/spec:\n  runtimeClassName: gvisor/' pod.yaml
cat > containerd-snippet.toml <<'N'
# SPDX-License-Identifier: MIT
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
N
cat > require-sandbox.yaml <<'N'
# SPDX-License-Identifier: MIT
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: require-gvisor}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - {apiGroups: [""], apiVersions: [v1], operations: [CREATE], resources: [pods]}
  validations:
    - expression: "has(object.spec.runtimeClassName) && object.spec.runtimeClassName == 'gvisor'"
      message: "Pods in this namespace must use the gvisor RuntimeClass"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: require-gvisor-builds}
spec:
  policyName: require-gvisor
  validationActions: [Deny]
  matchResources:
    namespaceSelector:
      matchLabels: {kubernetes.io/metadata.name: builds}
N
printf 'effective_cpu_m=750\neffective_memory_mi=376\n' > answer.txt
