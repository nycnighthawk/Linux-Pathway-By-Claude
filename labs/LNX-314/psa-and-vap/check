#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
cd "${LAB_DIR:-.}"
[ -f pod.yaml ] || { echo "FAIL: run setup first"; exit 1; }
python3 - <<'PY'
import sys, yaml
bad = 0
def chk(c, m):
    global bad
    print(("ok:   " if c else "FAIL: ") + m)
    if not c: bad = 1
def load(f):
    try: return [d for d in yaml.safe_load_all(open(f)) if d]
    except Exception as e: print("FAIL: %s: %s" % (f, e)); sys.exit(1)
# ---- 1. a Pod that passes the restricted level (subset of the real checks)
def restricted(p):
    s = p["spec"]; errs = []
    for k in ("hostNetwork", "hostPID", "hostIPC"):
        if s.get(k): errs.append(k)
    safe = {"configMap", "csi", "downwardAPI", "emptyDir", "ephemeral", "persistentVolumeClaim", "projected", "secret"}
    for v in s.get("volumes", []):
        if not (set(v) - {"name"}) <= safe: errs.append("volume " + v["name"])
    psc = s.get("securityContext") or {}
    for c in s.get("containers", []) + s.get("initContainers", []):
        sc = c.get("securityContext") or {}
        if sc.get("privileged"): errs.append("privileged")
        if sc.get("allowPrivilegeEscalation") is not False: errs.append("allowPrivilegeEscalation")
        if not (sc.get("runAsNonRoot", psc.get("runAsNonRoot")) is True): errs.append("runAsNonRoot")
        ru = sc.get("runAsUser", psc.get("runAsUser"))
        if ru == 0: errs.append("runAsUser 0")
        caps = sc.get("capabilities") or {}
        if "ALL" not in caps.get("drop", []): errs.append("drop ALL")
        if set(caps.get("add", [])) - {"NET_BIND_SERVICE"}: errs.append("added capabilities")
        sp = (sc.get("seccompProfile") or psc.get("seccompProfile") or {}).get("type")
        if sp not in ("RuntimeDefault", "Localhost"): errs.append("seccompProfile")
    return errs
p = load("pod.yaml")[0]
e = restricted(p)
chk(not e, "pod.yaml passes the restricted level" + ("" if not e else " (still failing: %s)" % ", ".join(sorted(set(e)))))
chk(p["spec"]["containers"][0]["image"].startswith("registry.example/agent"), "the image is unchanged")
chk(any(v.get("name") == "tmp" for v in p["spec"].get("volumes", [])), "the scratch volume is still there")
# ---- 2. namespace labels
ns = {d["metadata"]["name"]: (d["metadata"].get("labels") or {}) for d in load("namespaces.yaml") if d.get("kind") == "Namespace"}
P = "pod-security.kubernetes.io/"
def lv(n, k): return ns.get(n, {}).get(P + k)
chk(lv("prod", "enforce") == "restricted", "prod: enforce restricted")
chk(str(lv("prod", "enforce-version")).startswith("v1."), "prod: enforce-version pinned to a v1.x release")
chk(lv("prod", "warn") == "restricted" and lv("prod", "audit") == "restricted", "prod: warn and audit restricted")
chk(lv("staging", "enforce") == "baseline", "staging: enforce baseline")
chk(lv("staging", "warn") == "restricted" and lv("staging", "audit") == "restricted", "staging: warn and audit restricted (rollout path)")
# ---- 3. ValidatingAdmissionPolicy
docs = load("vap.yaml")
pol = [d for d in docs if d.get("kind") == "ValidatingAdmissionPolicy"]
bnd = [d for d in docs if d.get("kind") == "ValidatingAdmissionPolicyBinding"]
chk(len(pol) == 1 and len(bnd) == 1, "one policy and one binding")
if pol and bnd:
    sp = pol[0]["spec"]; sb = bnd[0]["spec"]
    chk(pol[0].get("apiVersion", "").startswith("admissionregistration.k8s.io/v1"), "apiVersion admissionregistration.k8s.io/v1 (stable API)")
    rules = (sp.get("matchConstraints") or {}).get("resourceRules") or []
    chk(any("pods" in r.get("resources", []) and "CREATE" in r.get("operations", []) for r in rules), "matches Pod creation")
    exprs = " ".join(v.get("expression", "") for v in sp.get("validations", []))
    chk("startsWith" in exprs and "registry.example/" in exprs, "an expression requires the registry.example/ prefix")
    chk("containers" in exprs and ("all(" in exprs), "the expression covers every container with all()")
    chk(all(v.get("message") for v in sp.get("validations", [])), "every validation has a message")
    chk(sp.get("failurePolicy") == "Fail", "failurePolicy Fail")
    chk(bnd[0]["spec"]["policyName"] == pol[0]["metadata"]["name"], "the binding names the policy")
    chk("Deny" in sb.get("validationActions", []), "binding action includes Deny")
    sel = sb.get("matchResources", {}).get("namespaceSelector", {})
    chk(bool(sel), "binding selects namespaces (not the whole cluster)")
sys.exit(bad)
PY
