#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
pid=$(cat .listener.pid)
line=$(ss -H -ltnp | grep "pid=$pid," | head -1)
addr=$(echo "$line" | awk '{print $4}')
mtu=$(cat /sys/class/net/lo/mtu)
st=$(ip -br link show lo | awk '{print $2}')
sed -i -e "s|^port=.*|port=${addr##*:}|" -e "s|^pid=.*|pid=$pid|" -e "s|^command=.*|command=python3|" \
  -e "s|^bind_address=.*|bind_address=${addr%:*}|" -e "s|^lo_mtu=.*|lo_mtu=$mtu|" -e "s|^lo_state=.*|lo_state=$st|" answers.txt
