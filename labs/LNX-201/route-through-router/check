#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Grade the live namespaces: specific routes via the router in both directions, and a ping across.
set -u
export LC_ALL=C
cd "${LAB_DIR:-.}"
bad=0
fail() { echo "FAIL: $*"; bad=1; }
ok() { echo "ok:   $*"; }
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO=sudo
$SUDO ip netns list 2>/dev/null | grep -q '^lab-a' || { echo "FAIL: namespace lab-a does not exist; run setup"; exit 1; }
ra=$($SUDO ip -n lab-a route show 2>/dev/null)
rb=$($SUDO ip -n lab-b route show 2>/dev/null)
echo "$ra" | grep -Eq '^10\.1\.2\.0/24 via 10\.1\.1\.1 ' && ok "lab-a has 10.1.2.0/24 via 10.1.1.1" || fail "lab-a needs a route to 10.1.2.0/24 via 10.1.1.1"
echo "$rb" | grep -Eq '^10\.1\.1\.0/24 via 10\.1\.2\.1 ' && ok "lab-b has 10.1.1.0/24 via 10.1.2.1" || fail "lab-b needs a route to 10.1.1.0/24 via 10.1.2.1"
echo "$ra$rb" | grep -q '^default' && fail "use specific routes, not default routes" || ok "no default routes were added"
if $SUDO ip netns exec lab-a ping -c1 -W2 10.1.2.2 >/dev/null 2>&1; then ok "lab-a reaches 10.1.2.2 (lab-b)"; else fail "ping from lab-a to 10.1.2.2 fails"; fi
if $SUDO ip netns exec lab-b ping -c1 -W2 10.1.1.2 >/dev/null 2>&1; then ok "lab-b reaches 10.1.1.2 (lab-a)"; else fail "ping from lab-b to 10.1.1.2 fails"; fi
exit $bad
