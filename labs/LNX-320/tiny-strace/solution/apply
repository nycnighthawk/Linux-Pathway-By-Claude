#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
python3 - <<'N'
s = open("tstrace.c").read()
a = s.index("/* TODO: run argv")
b = s.index("int main")
new = r'''static int run(char **argv)
{
    pid_t pid = fork();
    if (pid < 0)
        return 1;
    if (pid == 0) {
        pt(PTRACE_TRACEME, 0, 0, 0);
        execvp(argv[0], argv);
        _exit(127);
    }
    int st;
    waitpid(pid, &st, 0);
    if (!WIFSTOPPED(st))
        return 127;
    pt(PTRACE_SETOPTIONS, pid, 0, PTRACE_O_TRACESYSGOOD | PTRACE_O_EXITKILL);
    long cur = -1;
    int sig = 0, last = SYS_exit_group;
    for (;;) {
        pt(PTRACE_SYSCALL, pid, 0, sig);
        sig = 0;
        if (waitpid(pid, &st, 0) < 0)
            return 1;
        if (WIFEXITED(st)) {
            if (cur == SYS_exit_group)
                fprintf(stderr, "exit_group = ?\n");
            return WEXITSTATUS(st);
        }
        if (WIFSIGNALED(st))
            return 128 + WTERMSIG(st);
        if (WSTOPSIG(st) == (SIGTRAP | 0x80)) {
            struct ptrace_syscall_info si;
            memset(&si, 0, sizeof si);
            if (pt(PTRACE_GET_SYSCALL_INFO, pid, sizeof si, (long)&si) < 0)
                continue;
            if (si.op == PTRACE_SYSCALL_INFO_ENTRY) {
                cur = (long)si.entry.nr;
            } else if (si.op == PTRACE_SYSCALL_INFO_EXIT) {
                const char *n = name_of(cur);
                if (n)
                    print_result(n, si.exit.rval, si.exit.is_error);
                cur = -1;
            }
        } else if (WSTOPSIG(st) != SIGTRAP) {
            sig = WSTOPSIG(st);
        }
    }
    (void)last;
}

'''
open("tstrace.c", "w").write(s[:a] + new + s[b:])
N
