set -eu
cd "${LAB_DIR:-.}"
rm -f fdpass_test
cat > fdpass.c <<'N'
/* SPDX-License-Identifier: MIT */
#define _GNU_SOURCE
#include <errno.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/uio.h>
#include <unistd.h>

int send_fd(int sock, int fd)
{
    (void)sock; (void)fd;
    errno = ENOSYS;
    return -1;
}

int recv_fd(int sock)
{
    (void)sock;
    errno = ENOSYS;
    return -1;
}
N
