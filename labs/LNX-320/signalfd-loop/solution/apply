cd "${LAB_DIR:-.}"
cat > sigloop.c <<'N'
/* SPDX-License-Identifier: MIT */
#define _GNU_SOURCE
#include <errno.h>
#include <poll.h>
#include <signal.h>
#include <stdint.h>
#include <stdio.h>
#include <sys/signalfd.h>
#include <sys/timerfd.h>
#include <unistd.h>

int main(void)
{
    sigset_t m;
    sigemptyset(&m);
    sigaddset(&m, SIGUSR1);
    sigaddset(&m, SIGTERM);
    if (sigprocmask(SIG_BLOCK, &m, NULL) < 0)
        return 1;
    int sfd = signalfd(-1, &m, SFD_CLOEXEC);
    int tfd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC);
    struct itimerspec its = {.it_interval = {0, 100000000}, .it_value = {0, 100000000}};
    if (sfd < 0 || tfd < 0 || timerfd_settime(tfd, 0, &its, NULL) < 0)
        return 1;
    struct pollfd p[2] = {{sfd, POLLIN, 0}, {tfd, POLLIN, 0}};
    long usr1 = 0, ticks = 0;
    for (;;) {
        if (poll(p, 2, -1) < 0) {
            if (errno == EINTR)
                continue;
            return 1;
        }
        if (p[1].revents & POLLIN) {
            uint64_t n;
            if (read(tfd, &n, sizeof n) == sizeof n)
                ticks += (long)n;
        }
        if (p[0].revents & POLLIN) {
            struct signalfd_siginfo si;
            if (read(sfd, &si, sizeof si) == sizeof si) {
                if (si.ssi_signo == SIGUSR1)
                    usr1++;
                else {
                    printf("usr1=%ld ticks=%ld\n", usr1, ticks);
                    return 0;
                }
            }
        }
    }
}
N
