#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
rm -f opener
cat > opener.c <<'N'
/* SPDX-License-Identifier: MIT */
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

/* Writes a note to stderr; it looks for a site tag file first. */
static void log_note(const char *what)
{
    int fd = open("/nonexistent/site-tag", O_RDONLY);
    if (fd >= 0)
        close(fd);
    fprintf(stderr, "note: %s\n", what);
}

int main(int argc, char **argv)
{
    if (argc < 2)
        return 2;
    int fd = open(argv[1], O_WRONLY);
    if (fd < 0) {
        log_note("open failed");
        fprintf(stderr, "cannot open %s: %s\n", argv[1], strerror(errno));
        return 1;
    }
    close(fd);
    puts("opened");
    return 0;
}
N
