#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
printf '{# SPDX-License-Identifier: MIT #}\n{{ ansible_managed }}\nManaged host\n' > templates/motd.j2
cat > site.yml <<'PLAY'
# SPDX-License-Identifier: MIT
- name: A playbook that is safe to repeat
  hosts: localhost
  gather_facts: false
  vars:
    lab_out: "{{ playbook_dir }}/out"
  tasks:
    - name: Create the output directory
      ansible.builtin.file:
        path: "{{ lab_out }}"
        state: directory
        mode: "0755"
    - name: Make sure the setting is present exactly once
      ansible.builtin.lineinfile:
        path: "{{ lab_out }}/app.conf"
        regexp: '^setting='
        line: "setting=1"
        create: true
        mode: "0644"
    - name: Render the message of the day
      ansible.builtin.template:
        src: motd.j2
        dest: "{{ lab_out }}/motd"
        mode: "0644"
    - name: Initialise the data directory
      ansible.builtin.command: sh -c 'mkdir -p "{{ lab_out }}/data" && echo 16 > "{{ lab_out }}/data/PG_VERSION"'
      args:
        creates: "{{ lab_out }}/data/PG_VERSION"
    - name: Read the data version
      ansible.builtin.command: cat "{{ lab_out }}/data/PG_VERSION"
      register: data_version
      changed_when: false
      check_mode: false
      failed_when: false
    - name: Show the data version
      ansible.builtin.debug:
        msg: "data version {{ data_version.stdout | default('unknown') }}"
PLAY
sed -i -e 's/^check_option=.*/check_option=--check/' -e 's/^diff_option=.*/diff_option=--diff/' -e 's/^task_keyword_to_run_in_check_mode=.*/task_keyword_to_run_in_check_mode=check_mode: false/' -e 's/^check_mode_variable=.*/check_mode_variable=ansible_check_mode/' -e 's/^keyword_to_decide_changed=.*/keyword_to_decide_changed=changed_when/' answers.txt
