#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: an empty report to fill in after managing a Windows host from a Linux control node.
set -eu
cd "${LAB_DIR:-.}"
rm -f report.txt
cat > report.txt <<'R'
# SPDX-License-Identifier: MIT
# Windows report: fill in each ? from the Windows host you managed. See README.md.
connection_plugin=?
transport=?
port=?
cert_validation=?
win_ping_result=?
windows_edition=?
feature_changed_first_run=?
feature_changed_second_run=?
become_method=?
R
