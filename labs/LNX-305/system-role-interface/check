#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Run the learner's playbook in check mode, for real, and again, and compare the managed file.
set -u
export LC_ALL=C.UTF-8 ANSIBLE_NOCOLOR=1
cd "${LAB_DIR:-.}"
bad=0
fail() { echo "FAIL: $*"; bad=1; }
ok() { echo "ok:   $*"; }
[ -f .roles.sha ] || { echo "FAIL: .roles.sha is missing; run setup"; exit 1; }
sha256sum -c --quiet .roles.sha >/dev/null 2>&1 && ok "the vendored role is untouched (the interface is variables only)" || fail "do not edit the role: drive it from group_vars and the playbook"
[ -f site.yml ] || { fail "write site.yml that applies the hostsfile role to localhost"; exit 1; }
grep -q 'hostsfile' site.yml && ok "site.yml uses the role" || fail "site.yml must apply the hostsfile role"
printf '127.0.0.1 localhost\n10.0.0.9 old.example.org\n' > out/hosts
before=$(sha256sum out/hosts)
cout=$(ansible-playbook site.yml --check --diff 2>&1)
[ "$(sha256sum out/hosts)" = "$before" ] && ok "--check left the file alone" || fail "--check must not modify out/hosts"
printf '%s\n' "$cout" | sed -n 's/^localhost .*changed=\([0-9]*\).*/\1/p' | tail -1 | grep -qv '^0$' && ok "--check predicts changes" || fail "the check run should predict changes (or the play failed: run it by hand)"
out=$(ansible-playbook site.yml 2>&1); rc=$?
[ $rc = 0 ] && ok "real run succeeds" || { fail "playbook failed"; printf '%s\n' "$out" | tail -8; }
want=$(printf '127.0.0.1 localhost\n10.0.0.5 db.example.org db\n10.0.0.6 cache.example.org\n' | sort)
[ "$(sort out/hosts 2>/dev/null)" = "$want" ] && ok "out/hosts holds the two new entries and no old.example.org" || { fail "out/hosts must be: localhost, '10.0.0.5 db.example.org db', '10.0.0.6 cache.example.org' (old entry removed)"; cat out/hosts; }
second=$(ansible-playbook site.yml 2>&1 | sed -n 's/^localhost .*changed=\([0-9]*\).*/\1/p' | tail -1)
[ "$second" = 0 ] && ok "second run changed=0" || fail "second run must report changed=0 (got ${second:-none})"
grep -rqs 'hostsfile_entries' group_vars inventory host_vars 2>/dev/null && ok "the data lives in group_vars or the inventory" || fail "put hostsfile_entries and hostsfile_path in group_vars/all.yml, not in the role"
bout=$(ansible-playbook site.yml -e '{"hostsfile_entries":[{"names":["x"]}]}' 2>&1); brc=$?
{ [ $brc != 0 ] && printf '%s' "$bout" | grep -qi ip; } && ok "the role's argument spec rejects an entry without ip" || fail "an entry without ip should fail validation (did you edit the role?)"
get() { grep -E "^$1=" answers.txt 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'; }
[ "$(get variable_prefix)" = "the role name" ] || [ "$(get variable_prefix)" = hostsfile_ ] && ok "prefix" || fail "variable_prefix: what every public variable name starts with (the role name)"
[ "$(get internal_variable_prefix)" = "__" ] || [ "$(get internal_variable_prefix)" = "__hostsfile_" ] && ok "internal prefix" || fail "internal_variable_prefix: how internal variables are marked (two underscores)"
[ "$(get rhel_package)" = rhel-system-roles ] && ok "package" || fail "rhel_package: the RPM that installs the supported roles on a RHEL control node"
[ "$(get rhel_collection_fqcn_prefix)" = redhat.rhel_system_roles ] && ok "collection" || fail "rhel_collection_fqcn_prefix: namespace.collection of the vendor roles"
[ "$(get doc_directory)" = /usr/share/doc/rhel-system-roles ] && ok "docs" || fail "doc_directory: where the package installs README files and example playbooks"
exit $bad
