#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: an empty report to fill in from an AWX or automation controller you run yourself.
set -eu
cd "${LAB_DIR:-.}"
rm -f report.txt
cat > report.txt <<'R'
# SPDX-License-Identifier: MIT
# Controller report: fill in each ? from the controller you set up. See README.md.
controller_flavour=?
organization=?
inventory_hosts=?
credential_type=?
project_scm=?
job_template=?
execution_environment=?
job_status=?
role_granted=?
check_mode_run=?
R
