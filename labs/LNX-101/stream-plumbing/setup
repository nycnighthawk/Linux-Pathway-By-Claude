#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: a noisy program that writes to both output streams, and a task file.
set -eu
cd "${LAB_DIR:-.}"
cat > noisy <<'SH'
#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
echo "out 1"
echo "err 1" >&2
echo "out 2"
echo "err 2" >&2
echo "out 3"
SH
chmod +x noisy
