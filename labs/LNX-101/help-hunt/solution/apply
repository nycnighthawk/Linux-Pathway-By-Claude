#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Reference solution: the answers come from syncer --help and the shell itself.
set -eu
retries=$(./syncer --help | sed -n 's/.*--retries=N.*(default \([0-9]*\)).*/\1/p')
quiet=$(./syncer --help | sed -n 's/^  \(-q\), --quiet.*/\1/p')
cfg=$(./syncer --help | awk '/configuration file/ { print $1 }')
stream=stdout; [ -z "$(./syncer --help 2>&1 >/dev/null)" ] || stream=stderr
kind=$(type -t cd)
cat > answers.txt <<ANS
# SPDX-License-Identifier: MIT
retries_default=$retries
quiet_flag=$quiet
config_error_exit=$cfg
help_stream=$stream
manual_section_file_formats=5
cd_kind=$kind
ANS
