server_errors() {
    : TODO
}

# 3. Print the login names in users.txt whose numeric user id is 1000 or more and below 65534, one per line, sorted.
real_users() {
    : TODO
}

# 4. Print mail.txt with the part of every address before the @ replaced by ***, leaving everything else unchanged.
redact() {
    : TODO
}

# 5. Print the total number of lines in all files under files/ (the names contain spaces).
total_lines() {
    : TODO
}
