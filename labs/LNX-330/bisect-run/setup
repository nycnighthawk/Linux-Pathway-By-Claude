#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -eu
cd "${LAB_DIR:-.}"
rm -rf repo
git init -q -b main repo
cd repo
git config user.name "Lab User"; git config user.email "lab@example.org"; git config commit.gpgsign false
export GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z"
mk() { # n factor broken
  { echo '#!/usr/bin/env bash'
    echo "# build $1"
    if [ "$3" = 1 ]; then echo 'if [ "$1" -gt 0 ]; then'; fi   # unterminated if: a broken build
    echo "echo \$(( \$1 * $2 ))"; } > app.sh
}
for n in $(seq 1 24); do
  f=7; b=0
  [ "$n" -ge 12 ] && f=8
  { [ "$n" -ge 8 ] && [ "$n" -le 10 ]; } && b=1
  mk "$n" "$f" "$b"
  echo "note $n" > NOTES
  git add -A
  GIT_AUTHOR_DATE="2026-01-01T00:$(printf %02d $n):00Z" GIT_COMMITTER_DATE="2026-01-01T00:$(printf %02d $n):00Z" git commit -q -m "app: change $n"
done
git tag good "$(git rev-list --max-parents=0 HEAD)"
cat > test.sh <<'N'
#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# TODO: for `git bisect run`. Exit 0 = good, 1 (up to 127, not 125) = bad, 125 = cannot test.
# app.sh multiplies its argument by 7. Some commits do not even parse.
exit 0
N
chmod +x test.sh
echo "# put the full hash of the first bad commit here" > answer.txt
