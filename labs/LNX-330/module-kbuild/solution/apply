#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -eu
cd "${LAB_DIR:-.}"
python3 - <<'N'
s = open("mod/Makefile").read()
s = s.replace("obj-m := main.o util.o", "obj-m := hello.o\nhello-y := main.o util.o\nccflags-y := -DDEBUG -I$(src)/include")
open("mod/Makefile", "w").write(s)
m = open("mod/main.c").read()
m += 'MODULE_LICENSE("GPL");\nMODULE_DESCRIPTION("lab module");\n'
open("mod/main.c", "w").write(m)
N
