#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Structural grading of the report: every key present and each value of the right kind.
set -u
export LC_ALL=C.UTF-8
cd "${LAB_DIR:-.}"
bad=0
fail() { echo "FAIL: $*"; bad=1; }
ok() { echo "ok:   $*"; }
[ -f report.txt ] || { echo "FAIL: report.txt is missing; run setup"; exit 1; }
get() { grep -E "^$1=" report.txt | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'; }
chk() {
  v=$(get "$1")
  case "|$2|none|" in *"|$v|"*) ok "$1" ;; *) fail "$1 must be one of: ${2//|/, } or none ($3)" ;; esac
}
chk connection_plugin "psrp|winrm|ssh" "the ansible_connection value"
chk authentication "kerberos|ntlm|certificate|credssp|basic|publickey" "how you authenticated"
chk inventory_host_form "fqdn|ip" "what the inventory used"
chk ticket_source "kinit|keytab" "where the Kerberos ticket came from"
chk cert_validation "validate|ignore" "the certificate setting you used"
chk win_ping_result "pong|failed" "the result of win_ping"
chk feature_changed_first_run "yes|no" "first run of win_feature"
chk feature_changed_second_run "yes|no" "second run of win_feature"
chk double_hop_fix "become|delegation|credssp|fetch" "how to reach a second server"
chk shell_task_idempotent "yes|no" "win_shell without changed_when"
exit $bad
