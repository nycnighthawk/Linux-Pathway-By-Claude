#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > resolv.conf <<'EOT'
# SPDX-License-Identifier: MIT
search acme.example
nameserver 10.0.0.10
nameserver 10.0.0.11
EOT
cat > chrony-member.conf <<'EOT'
# SPDX-License-Identifier: MIT
server dc1.acme.example iburst
server dc2.acme.example iburst
makestep 1 3
driftfile /var/lib/chrony/drift
EOT
cat > chrony-dc.conf <<'EOT'
# SPDX-License-Identifier: MIT
server pool.ntp.org iburst
makestep 1 3
driftfile /var/lib/chrony/drift
bindcmdaddress 10.0.0.10
allow 10.0.0.0/16
ntpsigndsocket /var/lib/samba/ntp_signd
EOT
cat > answers.txt <<'EOT'
# SPDX-License-Identifier: MIT
failing_query=_ldap._tcp.dc._msdcs.acme.example
why_nxdomain=router-answered
max_kerberos_skew_minutes=5
tool_to_recreate_dc_records=samba_dnsupdate --verbose --all-names
EOT
