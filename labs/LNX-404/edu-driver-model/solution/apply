set -eu
cd "${LAB_DIR:-.}"
cat > driver.py <<'N'
# SPDX-License-Identifier: GPL-2.0-only
ENODEV, EINVAL, ETIMEDOUT = 19, 22, 110

def probe(dev):
    return 0 if dev.read(0x00) == 0x010000ed else -ENODEV

def liveness(dev, x):
    dev.write(0x04, x)
    return 0 if dev.read(0x04) == (~x) & 0xFFFFFFFF else -ENODEV

def factorial(dev, n, max_polls=100):
    if n < 0 or n > 12:
        return -EINVAL
    dev.write(0x08, n)
    for _ in range(max_polls):
        if not (dev.read(0x20) & 1):
            return dev.read(0x08)
    return -ETIMEDOUT
N
