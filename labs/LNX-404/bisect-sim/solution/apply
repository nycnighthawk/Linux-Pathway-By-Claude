set -eu
cd "${LAB_DIR:-.}"
cat > bisect.py <<'N'
# SPDX-License-Identifier: GPL-2.0-only
def bisect(n, test):
    if n < 2:
        raise ValueError("need at least two commits")
    lo, hi, runs = 0, n - 1, 0
    skipped = set()
    while hi - lo > 1:
        mid = (lo + hi) // 2
        order = [mid]
        for k in range(1, hi - lo):
            order += [mid + k, mid - k]
        cand = [c for c in order if lo < c < hi and c not in skipped]
        verdict = None
        for c in cand:
            runs += 1
            verdict = test(c)
            if verdict is None:
                skipped.add(c)
                continue
            if verdict:
                lo = c
            else:
                hi = c
            break
        else:
            raise ValueError("only skipped commits left")
    return hi, runs
N
