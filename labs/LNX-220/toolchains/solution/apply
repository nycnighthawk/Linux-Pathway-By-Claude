#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cc -O2 -o bin/c-dynamic src/hello.c
cc -O2 -static -o bin/c-static src/hello.c
rustc -O -C target-feature=+crt-static -o bin/rust-static src/hello.rs
( cd src/go && CGO_ENABLED=0 go build -o ../../bin/go-static . )
python3 -m venv --without-pip venv
sed -i -e 's/^static_c_flag=.*/static_c_flag=-static/' -e 's/^rust_static_codegen_option=.*/rust_static_codegen_option=-C target-feature=+crt-static/' -e 's/^go_cgo_variable=.*/go_cgo_variable=CGO_ENABLED=0/' -e 's/^venv_command=.*/venv_command=python3 -m venv venv/' -e 's/^linkage_inspection_tool=.*/linkage_inspection_tool=readelf/' answers.txt
