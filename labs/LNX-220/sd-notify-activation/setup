#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: an empty work directory with notes on the protocols; the learner writes the daemon and two unit files.
set -eu
cd "${LAB_DIR:-.}"
rm -rf daemon.py lab.service lab.socket answers.txt
cat > PROTOCOL.txt <<'X'
Socket activation (sd_listen_fds):
  LISTEN_PID  must equal this process id, otherwise the variables were meant for someone else
  LISTEN_FDS  number of passed descriptors; the first is fd 3
Readiness (sd_notify):
  NOTIFY_SOCKET  path of a datagram socket (a leading @ means the abstract namespace)
  datagrams of KEY=VALUE lines: STATUS=text, READY=1, STOPPING=1
Logging to the journal from stderr (sd-daemon priorities):
  a line starting with <3> is an error, <6> is informational
Behaviour required of daemon.py:
  1. refuse to run (exit 3, no READY=1) when LISTEN_PID is not its own pid or LISTEN_FDS is not 1
  2. log "<6>listening on inherited socket" to stderr, send STATUS=waiting then READY=1
  3. for each connection, read one line and answer "pong\n" to "ping" and "?\n" otherwise
  4. on SIGTERM send STOPPING=1 and exit 0
X
printf '# SPDX-License-Identifier: MIT\n# TODO: fill in each ?\nready_message=?\nfirst_passed_descriptor=?\nnotify_socket_variable=?\nservice_type_for_readiness=?\njournal_priority_for_info=?\n' > answers.txt
