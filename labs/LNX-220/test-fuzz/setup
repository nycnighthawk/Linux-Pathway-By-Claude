#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starting state: a small key=value parser with a buffer bug, and a standalone fuzz driver that replays or generates inputs.
set -eu
cd "${LAB_DIR:-.}"
rm -rf src answers.txt crash-input current-input
mkdir -p src .pristine
cat > src/parse.h <<'X'
/* SPDX-License-Identifier: MIT */
#ifndef PARSE_H
#define PARSE_H
#include <stddef.h>
struct kv { char key[8]; char val[16]; };
/* Parses "k=v;k=v" into out[0..max). Returns the number of pairs, or -1 on a malformed pair. */
int parse_kv(const char *buf, size_t len, struct kv *out, int max);
#endif
X
cat > src/parse.c <<'X'
/* SPDX-License-Identifier: MIT */
#include <string.h>
#include "parse.h"

int parse_kv(const char *buf, size_t len, struct kv *out, int max)
{
    int n = 0;
    size_t i = 0;
    while (i < len && n < max) {
        size_t ks = i;
        while (i < len && buf[i] != '=' && buf[i] != ';')
            i++;
        if (i >= len || buf[i] != '=')
            return -1;
        size_t klen = i - ks;
        if (klen == 0 || klen >= sizeof out[n].key)
            return -1;
        memcpy(out[n].key, buf + ks, klen);
        out[n].key[klen] = '\0';
        i++;
        size_t vs = i;
        while (i < len && buf[i] != ';')
            i++;
        size_t vlen = i - vs;
        memcpy(out[n].val, buf + vs, vlen);
        out[n].val[vlen] = '\0';
        n++;
        if (i < len)
            i++;
    }
    return n;
}
X
cp src/parse.c .pristine/parse.c
cat > src/driver.c <<'X'
/* SPDX-License-Identifier: MIT */
/* Minimal stand-in for libFuzzer's main(): replays the files named on the command line, or, with no arguments,
 * generates 200000 deterministic pseudo-random inputs. The current input is kept in ./current-input so that a
 * crash leaves its reproducer behind. */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size);

static void save(const uint8_t *d, size_t n)
{
    FILE *f = fopen("current-input", "wb");
    if (f) { fwrite(d, 1, n, f); fclose(f); }
}

int main(int argc, char **argv)
{
    for (int a = 1; a < argc; a++) {
        FILE *f = fopen(argv[a], "rb");
        if (!f) { perror(argv[a]); return 2; }
        uint8_t buf[4096];
        size_t n = fread(buf, 1, sizeof buf, f);
        fclose(f);
        LLVMFuzzerTestOneInput(buf, n);
    }
    if (argc > 1)
        return 0;
    static const char alpha[] = "ab=;=;xyz";
    unsigned long long s = 88172645463325252ULL;
    for (int iter = 0; iter < 200000; iter++) {
        uint8_t buf[80];
        s ^= s << 13; s ^= s >> 7; s ^= s << 17;
        size_t n = (size_t)(s % 70);
        for (size_t i = 0; i < n; i++) {
            s ^= s << 13; s ^= s >> 7; s ^= s << 17;
            buf[i] = (uint8_t)alpha[s % (sizeof alpha - 1)];
        }
        save(buf, n);
        LLVMFuzzerTestOneInput(buf, n);
    }
    puts("no crash found");
    return 0;
}
X
printf '# SPDX-License-Identifier: MIT\n# TODO: fill in each ?\nfuzz_entry_point=?\ncoverage_compile_flag=?\ncoverage_report_tool=?\nlibfuzzer_flag=?\nfuzzer_corpus_purpose=?\n' > answers.txt
