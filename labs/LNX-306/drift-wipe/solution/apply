#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
cd "${LAB_DIR:-.}"
cat > baseline.sh <<'SH'
#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -eu
dir=${1:?usage: baseline.sh DIR}
find "$dir" -type f -print0 | sort -z | xargs -0 sha256sum > baseline.sha256
SH
cat > drift.sh <<'SH'
#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Compare DIR with baseline.sha256. Prints A/D/M lines; exit 1 if anything differs.
set -eu
dir=${1:?usage: drift.sh DIR}
now=$(mktemp); trap 'rm -f "$now"' EXIT
find "$dir" -type f -print0 | sort -z | xargs -0 sha256sum > "$now"
rc=0
while read -r h p; do
  if ! grep -qF "  $p" "$now"; then echo "D $p"; rc=1; fi
done < baseline.sha256
while read -r h p; do
  old=$(grep -F "  $p" baseline.sha256 | cut -d' ' -f1 || true)
  if [ -z "$old" ]; then echo "A $p"; rc=1
  elif [ "$old" != "$h" ]; then echo "M $p"; rc=1; fi
done < "$now"
exit $rc
SH
cat > wipe.sh <<'SH'
#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Overwrite a regular image file with zeros, keep its size, verify.
set -eu
f=${1:?usage: wipe.sh FILE}
[ -e "$f" ] || { echo "no such file: $f" >&2; exit 2; }
[ -f "$f" ] && [ ! -L "$f" ] || { echo "refusing: $f is not a regular file" >&2; exit 2; }
size=$(stat -c %s "$f")
head -c "$size" /dev/zero | dd of="$f" bs=1M conv=notrunc,fsync status=none
cmp -s "$f" <(head -c "$size" /dev/zero) || { echo "verification failed" >&2; exit 3; }
echo "wiped $f ($size bytes), verified"
SH
chmod +x baseline.sh drift.sh wipe.sh
