#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
export LC_ALL=C
cd "${LAB_DIR:-.}"
bad=0
fail() { echo "FAIL: $*"; bad=1; }
ok() { echo "ok:   $*"; }
[ -f firmware-campaign.txt ] || { echo "FAIL: firmware-campaign.txt is missing; run setup"; exit 1; }
get() { grep -E "^$1=" firmware-campaign.txt | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'; }
eq() { [ "$(get "$1")" = "$2" ] && ok "$1=$2" || fail "$1 must be $2"; }
eq firmware_source vendor_site
eq verify_image checksum_or_signature
eq read_release_notes yes
eq group_by model_and_version
eq first_test_target sacrificial_machine
eq test_console_access yes
eq config_backup yes
p=$(get pilot_size); if printf '%s' "$p" | grep -Eq '^[0-9]+$' && [ "$p" -ge 1 ] && [ "$p" -le 6 ]; then ok "pilot of $p machines"; else fail "pilot_size: an integer from 1 to 6"; fi
w=$(get wave_sizes)
if printf '%s' "$w" | grep -Eq '^[0-9]+(,[0-9]+)+$'; then
  sum=0; prev=0; mono=1
  for n in $(printf '%s' "$w" | tr ',' ' '); do sum=$((sum + n)); [ "$n" -ge "$prev" ] || mono=0; prev=$n; done
  total=$((sum + ${p:-0}))
  [ "$mono" = 1 ] && ok "waves grow (never shrink)" || fail "wave_sizes must not decrease"
  [ "$total" = 120 ] && ok "pilot plus waves cover all 120 servers" || fail "pilot_size plus the wave sizes must add up to 120 (now $total)"
else fail "wave_sizes: comma list of at least two integers"; fi
eq stop_rule pause_on_any_failure
eq power_protection ups_or_stable
eq interrupt_update never
eq preserve_config_check yes
t=$(get post_update_checks); for k in version network accounts event_log power_control; do case ",$t," in *",$k,"*) ok "post-update check $k" ;; *) fail "post_update_checks must include $k" ;; esac; done
eq default_account_after absent
eq signed_images_only yes
eq record_in_inventory yes
exit "$bad"
