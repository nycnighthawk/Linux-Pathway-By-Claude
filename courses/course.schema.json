{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nycnighthawk/Linux-Pathway-By-Claude/courses/course.schema.json",
  "title": "Course descriptor (courses/<COURSE>/course.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "hours", "outcomes", "modules", "labs", "quizzes"],
  "properties": {
    "id": {"type": "string", "pattern": "^LNX-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string"},
    "hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 400},
    "coverage": {
      "enum": ["full", "partial"], "default": "full",
      "description": "full: every topic of the course in taxonomy/topics.yaml needs a lesson; partial: missing topics only warn (a slice in progress)."
    },
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "certifications": {
      "type": "array",
      "description": "Certification refs. cert must be one of the course's certs in taxonomy/courses.yaml; objectives are checked against objectives/<cert>.yml when that file exists.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["cert"],
        "properties": {"cert": {"type": "string", "minLength": 2}, "objectives": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "lessons"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 3},
          "lessons": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["topic", "title", "file"],
              "properties": {
                "topic": {"type": "string", "pattern": "^LNX-[0-9]{3}-T[0-9]{2}$"},
                "title": {"type": "string", "minLength": 3},
                "file": {"type": "string", "pattern": "^lessons/[A-Za-z0-9_.-]+\\.md$"},
                "minutes": {"type": "integer", "minimum": 5, "maximum": 240}
              }
            }
          }
        }
      }
    },
    "labs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "topic", "title", "env", "license"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "topic": {"type": "string", "pattern": "^LNX-[0-9]{3}-T[0-9]{2}$"},
          "title": {"type": "string", "minLength": 3},
          "env": {"enum": ["C", "V", "W", "S", "K", "H", "O"], "description": "C container, V nested KVM VM, W Windows runner (graded in CI); S self-hosted, K cloud, H hardware, O time or human (manual guides)."},
          "license": {"enum": ["MIT", "GPL-2.0-only"]},
          "kind": {"enum": ["kernel-module", "kvm", "qemu", "other"], "description": "kernel-module, kvm and qemu labs must be GPL-2.0-only."},
          "minutes": {"type": "integer", "minimum": 5, "maximum": 480},
          "packages": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]*$"}, "description": "apt packages the CI container installs before running the lab."}
        }
      }
    },
    "quizzes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "topic", "file"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "topic": {"type": "string", "pattern": "^LNX-[0-9]{3}-T[0-9]{2}$"},
          "title": {"type": "string"},
          "file": {"type": "string", "pattern": "^quizzes/[A-Za-z0-9_.-]+\\.ya?ml$"}
        }
      }
    }
  }
}
