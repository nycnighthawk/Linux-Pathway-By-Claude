{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz bank (courses/<COURSE>/quizzes/*.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "title": {"type": "string"},
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "prompt", "choices", "answer", "explain"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "prompt": {"type": "string", "minLength": 3},
          "choices": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
          "answer": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "description": "0-based indexes of the correct choices; more than one makes it a multi-select question."},
          "explain": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
